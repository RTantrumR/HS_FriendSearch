<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs plugin/FriendMatch.cs outside the game (dotnet run, project tests). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\plugin\FriendMatch.cs" Link="FriendMatch.cs" />
  </ItemGroup>
</Project>
